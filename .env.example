# Copy to .env. Never commit real credentials.

# mock | ollama | bedrock | anthropic | auto
# The default is always local and free. Select a paid cloud provider only intentionally.
LLM_PROVIDER=mock

# Local Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# AWS Bedrock. Configure credentials with `aws configure` or environment variables.
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# API safety and browser access
MAX_UPLOAD_MB=10
LLM_TIMEOUT_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend; leave blank in local Vite development to use the /api proxy.
VITE_API_URL=
